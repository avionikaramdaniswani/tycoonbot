# ===== Server =====
PORT=3000
NODE_ENV=development
# URL dashboard yang diizinkan (CORS). Untuk dev Vite default:
CORS_ORIGIN=http://localhost:5173

# ===== Login Dashboard =====
# Ganti kredensial ini sebelum dipakai!
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=admin123
# Secret untuk JWT — WAJIB diganti dengan string acak yang panjang
JWT_SECRET=ganti-dengan-secret-acak-yang-panjang

# ===== Bot =====
BOT_NAME=Bot Terbaru
BOT_PREFIX=.
# Nomor owner (format internasional tanpa +, contoh: 628123456789)
OWNER_NUMBER=628123456789

# ===== MongoDB =====
# Isi dengan connection string Atlas untuk simpan sesi & data di DB (cocok untuk deploy).
# Kosongkan untuk fallback ke penyimpanan file lokal (folder sessions/).
MONGODB_URI=
MONGODB_DB=piobot
